{
  "$comment": [
    "Configuration for tools/model-tiers/model-tiers.ts (see the script header for usage).",
    "Tiers are evaluated top-down in the key order of `tiers`; each tier's top slot is",
    "reserved from lower tiers unless escalation.allow is true."
  ],
  "api": {
    "baseUrl": "https://artificialanalysis.ai/api/v2",
    "fullPath": "/language/models",
    "freePath": "/language/models/free",
    "cacheDir": "~/.cache/model-tiers",
    "cacheTtlHours": 12
  },
  "capability": {
    "$comment": "Capability = weighted blend of AA indices, renormalized over whatever the endpoint exposes. Weights need not sum to 1. software_engineering is used only if a response carries it (list endpoints currently do not), in which case the 0.6/0.4 split becomes 0.45/0.30/0.25.",
    "weights": {
      "coding": 0.45,
      "intelligence": 0.3,
      "software_engineering": 0.25
    }
  },
  "cost": {
    "$comment": "subscriptionWeight scales the cost of models behind subscription providers (marginal cost ~0 until quota) but must stay > 0 so a subscription model never looks infinitely cheap. It applies to every cost comparison.",
    "subscriptionWeight": 0.25,
    "defaultBilling": "metered",
    "providers": {
      "openai-codex": {
        "billing": "subscription"
      },
      "kimi-coding": {
        "billing": "subscription"
      },
      "opencode-go": {
        "billing": "subscription"
      },
      "google": {
        "billing": "metered"
      },
      "groq": {
        "billing": "metered"
      },
      "huggingface": {
        "billing": "metered"
      },
      "claude": {
        "billing": "subscription",
        "weight": 0.9,
        "$comment": "Claude is the operator's scarcest provider: it is a subscription, but the discount is small (weight 0.9 instead of subscriptionWeight) so cost keeps counting."
      }
    }
  },
  "blocked": [
    {
      "match": "opencode-go/deepseek-v4*",
      "reason": "region-blocked for this operator (2026-09)"
    },
    {
      "match": "opencode-go/deepseek-*",
      "reason": "region-blocked for this operator (2026-09)"
    },
    {
      "match": "groq/*",
      "reason": "rejects pi's prompt_cache_key (2026-09)"
    }
  ],
  "quota": {
    "$comment": [
      "Agent loops spend one request per tool step, so a model with few requests per 5h is unfit as the primary of a loop-heavy tier even when its metrics are great.",
      "requests_per_5h: number = documented cap; `unlimited: true` = no documented cap (time-limited free models);",
      "absent = unknown, treated as unrestricted and flagged `quota: unknown` in the output.",
      "tiers.minRequestsPer5h is the per-tier floor; a model below it is kept out of that tier's chain entirely."
    ],
    "source": "operator plan limits, 2026-09",
    "tiers": {
      "cto": 0,
      "lead": 1000,
      "senior": 1000,
      "dev": 1000,
      "intern": 1000,
      "research": 1000
    },
    "providers": {
      "opencode-go": {
