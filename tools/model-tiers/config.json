    {
      "name": "Kimi K3",
      "between": [
        "gpt6astra",
        "gpt6sol"
      ],
      "source": "operator ranking; /free carries no Kimi K3 row",
      "fraction": 0.15,
      "$comment": "Judgment call: the operator ranks Kimi K3 second overall, directly under GPT-6 Astra / Claude Opus and above GPT-6 Sol, so it sits 15% of the way down from GPT-6 Astra to GPT-6 Sol. Tune `fraction`; a real AA row replaces this."
    }
  ],
  "operatorRanking": [
    [
      "*/gpt-6-astra",
      "claude/opus",
      "claude/fable*"
    ],
    [
      "*/kimi-k3",
      "kimi-coding/k3*",
      "huggingface/moonshotai/Kimi-K3"
    ],
