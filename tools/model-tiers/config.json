  "free": {
    "$comment": [
      "Free-tier models that Artificial Analysis does not cover. Policy: every tier's chain gets the `first-fallback` model right after the primary and the `last` model at the very end, unless the tier is in excludeTiers.",
      "They are placed, never ranked; cost is 0 and quota comes from quota.providers (unlimited). qualityOverride is a third-party figure on a different scale than AA capability, shown for information only.",
      "availableUntil stays \"unknown\" until the provider announces an end date; the quota block marks these models 'unlimited (limited time)'."
    ],
    "availableUntil": "unknown",
    "excludeTiers": [
      "intern"
    ],
    "models": {
      "opencode-go/space-bunny-free": {
        "position": "first-fallback",
        "qualityOverride": {
          "capability": 52.61,
          "source": "aicodingdaily 2026-09, ~ GPT-6-Sol High",
          "speedSeconds": 1140
        },
        "note": "slow: ~19 min per prompt"
      },
      "opencode-go/longcat-2.5-preview-free": {
        "position": "last",
        "qualityOverride": {
          "capability": 44.25,
          "source": "aicodingdaily 2026-09"
        }
      }
    }
  },
  "providerStatus": {
    "$comment": "Operator-reported provider health, printed as advisory context only. Never used to exclude a model: quotas and outages are temporary. `asOf` dates the report.",
    "asOf": "2026-09-30",
    "providers": {
      "google": {
        "state": "degraded",
        "note": "returns 402: prepayment credits depleted"
      },
      "openai-codex": {
        "state": "quota",
        "note": "hit the 5-hour usage limit on 2026-09-30"
      },
      "kimi-coding": {
        "state": "quota",
        "note": "hit the 5-hour usage limit on 2026-09-30"
      }
    }
  },
  "chainLength": 5,
  "diversity": {
    "$comment": "A chain should span at least minProviders pi providers where possible, so quota exhaustion on one provider does not empty the chain. If the pool holds no other provider, the chain is left as-is and flagged.",
    "minProviders": 2
  },
  "escalation": {
    "$comment": "never auto-escalate: a tier's chain excludes any model holding a higher tier's top slot. scope=model reserves the AA base model across providers; scope=entry reserves only the specific provider/model.",
    "allow": false,
    "scope": "model"
  },
  "research": {
    "$comment": "Research axis: long context and low cost, no capability floor. Context window comes from pi's own model registry. `prefer` pins the operator's favourites first, in order.",
    "minContextTokens": 200000,
    "prefer": [
      "google/gemini-3.8-flash"
    ]
  },
  "metricsFallback": "flagship",
  "tiers": {
    "cto": {
      "minCapabilityRatio": 0.95,
      "rankBy": [
        "capability"
      ],
      "thinking": "high"
    },
    "lead": {
      "minCapabilityRatio": 0.92,
      "rankBy": [
        "capability",
        "cost"
      ],
      "thinking": "high",
      "capabilityBucket": 2
    },
    "senior": {
      "minCapabilityRatio": 0.85,
      "rankBy": [
        "capability",
        "cost"
      ],
      "thinking": "high",
      "capabilityBucket": 2
    },
    "dev": {
      "minCapabilityRatio": 0.75,
      "rankBy": [
        "capability",
        "cost",
        "speed"
      ],
      "thinking": "medium",
      "capabilityBucket": 4,
      "maxCapabilityRatio": 0.9
    },
    "intern": {
      "minCapabilityRatio": 0.55,
      "rankBy": [
        "cost",
        "speed"
      ],
      "thinking": "low",
      "maxCapabilityRatio": 0.8
    },
    "research": {
      "axis": "context-cost",
      "minCapabilityRatio": 0.4,
      "rankBy": [
        "cost",
        "speed"
      ],
      "thinking": "off"
    }
  },
  "aliases": {
    "$comment": "Normalized AA base name/slug -> explicit pi provider/model ids. Additive to normalized name matching. Keys are normalizeName() output: lowercase, parentheticals and non-alphanumerics removed (e.g. 'Kimi K3' -> 'kimik3').",
    "kimik3": [
      "kimi-coding/k3",
      "opencode-go/kimi-k3"
    ],
    "kimik3256k": [
      "kimi-coding/k3-256k"
    ],
    "kimiforcoding": [
      "kimi-coding/kimi-for-coding"
    ],
    "kimiforcodinghighspeed": [
      "kimi-coding/kimi-for-coding-highspeed"
    ],
    "kimik2thinking": [
